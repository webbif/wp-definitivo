{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1440px"
    },
    "color": {
      "custom": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "sky",
          "name": "Canvas",
          "color": "#F6F8FC"
        },
        {
          "slug": "container",
          "name": "Container",
          "color": "#F8FBFF"
        },
        {
          "slug": "card",
          "name": "Card",
          "color": "#FFFFFF"
        },
        {
          "slug": "navy",
          "name": "Navy",
          "color": "#0F172A"
        },
        {
          "slug": "ocean",
          "name": "Deep blue",
          "color": "#0F3D73"
        },
        {
          "slug": "light-blue",
          "name": "Blue",
          "color": "#14599F"
        },
        {
          "slug": "ivory",
          "name": "Ivory",
          "color": "#FAF8F5"
        },
        {
          "slug": "charcoal",
          "name": "Charcoal",
          "color": "#2B2527"
        },
        {
          "slug": "wine",
          "name": "Wine",
          "color": "#7A263A"
        },
        {
          "slug": "rose",
          "name": "Rose",
          "color": "#B76A78"
        },
        {
          "slug": "sand",
          "name": "Sand",
          "color": "#F4F0E6"
        },
        {
          "slug": "forest",
          "name": "Forest",
          "color": "#28533F"
        },
        {
          "slug": "night",
          "name": "Night",
          "color": "#1F191B"
        }
      ]
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "2XS",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "XS",
          "size": "0.75rem"
        },
        {
          "slug": "40",
          "name": "Small",
          "size": "1rem"
        },
        {
          "slug": "50",
          "name": "Medium",
          "size": "clamp(1.5rem, 3vw, 2rem)"
        },
        {
          "slug": "60",
          "name": "Large",
          "size": "clamp(2rem, 5vw, 4rem)"
        },
        {
          "slug": "70",
          "name": "XL",
          "size": "clamp(3rem, 8vw, 6rem)"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "inter",
          "name": "Inter",
          "fontFamily": "\"Inter\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontStyle": "normal",
              "fontWeight": "400 800",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/inter-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "jetbrains-mono",
          "name": "JetBrains Mono",
          "fontFamily": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Consolas, \"Liberation Mono\", monospace",
          "fontFace": [
            {
              "fontFamily": "JetBrains Mono",
              "fontStyle": "normal",
              "fontWeight": "400 600",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/jetbrains-mono-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "1rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.25rem, 2vw, 1.5rem)"
        },
        {
          "slug": "x-large",
          "name": "Extra large",
          "size": "clamp(1.75rem, 4vw, 2.75rem)"
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(2.75rem, 7vw, 5.5rem)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#F6F8FC",
      "text": "#0F172A"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "1.125rem",
      "lineHeight": "1.65"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "0.35rem"
        },
        "color": {
          "background": "#0F3D73",
          "text": "#FFFFFF"
        },
        "typography": {
          "fontWeight": "700"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontWeight": "700",
          "lineHeight": "1.12"
        }
      },
      "link": {
        "color": {
          "text": "#0F3D73"
        },
        ":hover": {
          "typography": {
            "textDecoration": "none"
          }
        }
      }
    },
    "blocks": {
      "core/code": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--jetbrains-mono)"
        }
      },
      "core/preformatted": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--jetbrains-mono)"
        }
      },
      "core/button": {
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "right": "1.25rem",
            "bottom": "0.75rem",
            "left": "1.25rem"
          }
        }
      },
      "core/quote": {
        "border": {
          "color": "#14599F",
          "style": "solid",
          "width": "0 0 0 4px"
        },
        "spacing": {
          "padding": {
            "left": "1.5rem"
          }
        }
      }
    }
  }
}
