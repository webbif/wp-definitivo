{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "landingPage": "/",
  "plugins": [
    "theme-check",
    "woocommerce"
  ],
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_DEBUG": true,
        "WP_DEBUG_DISPLAY": true,
        "WP_DEBUG_LOG": true,
        "SCRIPT_DEBUG": true
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "WP Definitivo Integration",
        "blogdescription": "WooCommerce and Elementor smoke test"
      }
    },
    {
      "step": "wp-cli",
      "command": "wp theme activate wp-definitivo"
    },
    {
      "step": "wp-cli",
      "command": "wp plugin activate theme-check"
    },
    {
      "step": "wp-cli",
      "command": "wp plugin activate woocommerce"
    }
  ]
}
